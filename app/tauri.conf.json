{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixhaus",
  "version": "0.1.0",
  "identifier": "app.pixhaus.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter pixhaus-ui dev",
    "beforeBuildCommand": "pnpm --filter pixhaus-ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pixhaus",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pixhaus-app/pixhaus/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_OUTPUT_OF_scripts/gen-updater-key",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../examples/samples/*.pixhaus": "examples/samples/"
    },
    "category": "GraphicsAndDesign",
    "shortDescription": "AI-native pixel art editor",
    "longDescription": "Pixhaus is an open-source AI-native pixel art editor for sprites, animations, and tilemaps."
  }
}
