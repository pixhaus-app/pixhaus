{
  "name": "pixhaus-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,tests}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@sentry/browser": "^10.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-solid": "^1.23.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-solid": "^0.14.5",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.9"
  }
}
