{
  "name": "@pixhaus/e2e-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "End-to-end test suite driving the Pixhaus binary via tauri-driver + WebdriverIO.",
  "scripts": {
    "e2e": "wdio run wdio.conf.ts",
