---
const navLinks = [
  { href: "/features", label: "Features" },
  { href: "/compare", label: "Compare" },
  { href: "/download", label: "Download" },
  { href: "https://docs.pixhaus.app", label: "Docs", external: true },
  { href: "/blog", label: "Blog" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-[var(--z-dropdown)] border-b"
  style="background: rgba(15,15,19,0.88); backdrop-filter: blur(12px); border-color: var(--color-neutral-200);"
>
  <div
    class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between gap-8"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Pixhaus home">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 100 100"
        width="28"
        height="28"
        aria-hidden="true"
      >
        <g fill="currentColor" style="color: #7c6cef;">
          <rect x="41" y="1" width="18" height="18" rx="2" />
          <rect x="21" y="21" width="18" height="18" rx="2" />
          <rect x="41" y="21" width="18" height="18" rx="2" />
          <rect x="61" y="21" width="18" height="18" rx="2" />
          <rect x="1" y="41" width="18" height="18" rx="2" />
          <rect x="21" y="41" width="18" height="18" rx="2" />
          <rect x="41" y="41" width="18" height="18" rx="2" />
          <rect x="61" y="41" width="18" height="18" rx="2" />
          <rect x="81" y="41" width="18" height="18" rx="2" />
          <rect x="1" y="61" width="18" height="18" rx="2" />
          <rect x="21" y="61" width="18" height="18" rx="2" />
          <rect x="61" y="61" width="18" height="18" rx="2" />
          <rect x="81" y="61" width="18" height="18" rx="2" />
          <rect x="1" y="81" width="18" height="18" rx="2" />
          <rect x="21" y="81" width="18" height="18" rx="2" />
          <rect x="61" y="81" width="18" height="18" rx="2" />
          <rect x="81" y="81" width="18" height="18" rx="2" />
        </g>
      </svg>
      <span
        style="font-size: 18px; font-weight: 600; letter-spacing: -0.03em; color: var(--color-neutral-900);"
        >pixhaus</span
      >
    </a>

    <!-- Nav links (desktop) -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {
        navLinks.map(({ href, label, external }) => (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="px-3 py-1.5 rounded text-sm transition-colors"
            style={
              currentPath === href
                ? "color: var(--color-neutral-900);"
                : "color: var(--color-neutral-600);"
            }
            aria-current={currentPath === href ? "page" : undefined}
          >
            {label}
            {external && (
              <span aria-hidden="true" class="ml-0.5 opacity-50">
                ↗
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <!-- Right side actions -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="https://github.com/pixhaus-app/pixhaus"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded text-sm transition-colors"
        style="color: var(--color-neutral-600); border: 1px solid var(--color-neutral-300);"
        aria-label="View Pixhaus on GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href="/download"
        class="px-3 py-1.5 rounded text-sm font-medium transition-colors"
        style="background: var(--brand-indigo-500); color: white;"
      >
        Download
      </a>
    </div>
  </div>
</header>
