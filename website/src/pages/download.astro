---

<BaseLayout
  title="Download"
  description="Download Pixhaus for Windows, macOS, and Linux. Free forever, MIT license."
  ogImage="/og/download.svg"
>
  <div class="max-w-6xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1
        class="text-3xl md:text-5xl font-bold mb-4"
        style="color: var(--color-neutral-900); letter-spacing: -0.04em;"
      >
        Download Pixhaus
      </h1>
      <p class="text-lg" style="color: var(--color-neutral-600);">
        Free forever. No account required. MIT license.
      </p>
    </div>

    <!-- Platform grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {
        platforms.map(({ name, format, icon, href, primary }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-5 rounded-xl transition-colors group"
            style={`border: 1px solid ${primary ? "var(--brand-indigo-600)" : "var(--color-neutral-200)"}; background: ${primary ? "rgba(124,108,239,0.06)" : "var(--color-neutral-50)"};`}
          >
            <div
              class="shrink-0"
              style={`color: ${primary ? "var(--brand-indigo-400)" : "var(--color-neutral-500)"};`}
              set:html={icon}
            />
            <div class="flex-1 min-w-0">
              <p
                class="text-sm font-semibold"
                style={`color: ${primary ? "var(--brand-indigo-300)" : "var(--color-neutral-900)"};`}
              >
                {name}
              </p>
              <p class="text-xs mt-0.5" style="color: var(--color-neutral-500);">
                {format}
              </p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              class="shrink-0"
              style="color: var(--color-neutral-500);"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              />
            </svg>
          </a>
        ))
      }
    </div>

    <!-- System requirements -->
    <div
      class="rounded-xl p-8 mb-12"
      style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200);"
    >
      <h2
        class="text-lg font-semibold mb-6"
        style="color: var(--color-neutral-900);"
      >
        System requirements
      </h2>
      <div class="grid sm:grid-cols-3 gap-8">
        {
          [
            {
              os: "Windows",
              reqs: ["Windows 10 or later (64-bit)", "4 GB RAM minimum, 8 GB recommended", "OpenGL 3.3 or DirectX 11", "500 MB disk space"],
            },
            {
              os: "macOS",
              reqs: ["macOS 11 (Big Sur) or later", "4 GB RAM minimum, 8 GB recommended", "Metal GPU support", "500 MB disk space"],
            },
            {
              os: "Linux",
              reqs: ["Ubuntu 22.04 / Fedora 38 or equivalent", "4 GB RAM minimum, 8 GB recommended", "OpenGL 3.3 compatible GPU", "500 MB disk space"],
            },
          ].map(({ os, reqs }) => (
            <div>
              <h3
                class="text-sm font-semibold mb-3"
                style="color: var(--color-neutral-700);"
              >
                {os}
              </h3>
              <ul class="space-y-2">
                {reqs.map((req) => (
                  <li class="flex items-start gap-2 text-sm" style="color: var(--color-neutral-600);">
                    <span class="mt-1 shrink-0" style="color: var(--brand-indigo-500);">&#10003;</span>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Build from source -->
    <div
      class="rounded-xl p-8"
      style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200);"
    >
      <h2
        class="text-lg font-semibold mb-4"
        style="color: var(--color-neutral-900);"
      >
        Build from source
      </h2>
      <p class="text-sm mb-4" style="color: var(--color-neutral-600);">
        Requires Rust (stable toolchain via rustup), Node.js 22+, and pnpm 10+.
      </p>
      <pre
        class="rounded-lg overflow-x-auto p-4 text-sm font-mono"
        style="background: var(--color-neutral-100); color: var(--color-neutral-800); border: 1px solid var(--color-neutral-200);"
      ><code>git clone https://github.com/pixhaus-app/pixhaus
cd pixhaus
pnpm bootstrap
pnpm dev</code></pre>
      <p class="text-xs mt-4" style="color: var(--color-neutral-500);">
        See{" "}
        <a
          href="https://github.com/pixhaus-app/pixhaus/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="underline"
          style="color: var(--brand-indigo-400);"
        >
          CONTRIBUTING.md
        </a>{" "}
        for the full setup guide.
      </p>
    </div>
  </div>
</BaseLayout>
