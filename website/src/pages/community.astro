---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Community"
  description="Join the Pixhaus community on GitHub and Discord. Open source, built in public."
  ogImage="/og/community.svg"
>
  <div class="max-w-6xl mx-auto px-6 py-20">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1
        class="text-3xl md:text-5xl font-bold mb-4"
        style="color: var(--color-neutral-900); letter-spacing: -0.04em;"
      >
        Community
      </h1>
      <p class="text-lg max-w-xl mx-auto" style="color: var(--color-neutral-600);">
        Pixhaus is built in public. Ask questions, share your work, or help
        shape what gets built next.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid sm:grid-cols-2 gap-6 mb-16">
      {
        [
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
            title: "GitHub",
            body: "Source code, issues, pull requests, and releases. This is where the project lives.",
            links: [
              { label: "Repository", href: "https://github.com/pixhaus-app/pixhaus" },
              { label: "Discussions", href: "https://github.com/pixhaus-app/pixhaus/discussions" },
              { label: "Issues", href: "https://github.com/pixhaus-app/pixhaus/issues" },
              { label: "Releases", href: "https://github.com/pixhaus-app/pixhaus/releases" },
            ],
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.1.127 18.14.16 18.16a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`,
            title: "Discord",
            body: "Ask questions, share screenshots, discuss plugin ideas, and follow development.",
            links: [
              { label: "Join the server", href: "https://discord.gg/pixhaus" },
            ],
          },
        ].map(({ icon, title, body, links }) => (
          <div
            class="p-8 rounded-xl"
            style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200);"
          >
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-5"
              style="background: rgba(124,108,239,0.12); color: var(--brand-indigo-400);"
              set:html={icon}
            />
            <h2
              class="text-lg font-bold mb-2"
              style="color: var(--color-neutral-900);"
            >
              {title}
            </h2>
            <p class="text-sm mb-5 leading-relaxed" style="color: var(--color-neutral-600);">
              {body}
            </p>
            <div class="flex flex-wrap gap-3">
              {links.map(({ label, href }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium px-4 py-2 rounded-lg transition-colors"
                  style="background: rgba(124,108,239,0.1); color: var(--brand-indigo-300); border: 1px solid rgba(124,108,239,0.2);"
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Contributing -->
    <div
      class="rounded-xl p-8 mb-10"
      style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200);"
    >
      <h2
        class="text-lg font-bold mb-4"
        style="color: var(--color-neutral-900);"
      >
        Contributing
      </h2>
      <p class="text-sm mb-4 leading-relaxed" style="color: var(--color-neutral-600);">
        Pixhaus uses a parallel-stream development model: features are
        independent branches worked by individual contributors or agents.
        The repo has a detailed contributing guide covering branch naming,
        commit format, the task queue, and the AI-assisted dispatch workflow.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/pixhaus-app/pixhaus/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium"
          style="color: var(--brand-indigo-400);"
        >
          Read CONTRIBUTING.md &rarr;
        </a>
        <a
          href="https://github.com/pixhaus-app/pixhaus/blob/main/CODE_OF_CONDUCT.md"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium"
          style="color: var(--brand-indigo-400);"
        >
          Code of conduct &rarr;
        </a>
      </div>
    </div>

    <!-- Support the project -->
    <div
      class="rounded-xl p-8"
      style="background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200);"
    >
      <h2
        class="text-lg font-bold mb-4"
        style="color: var(--color-neutral-900);"
      >
        Support the project
      </h2>
      <p class="text-sm leading-relaxed" style="color: var(--color-neutral-600);">
        Pixhaus is MIT-licensed and has no paid tier. Sustainability comes
        from sponsorships and grant funding — the Krita and Blender model.
        If Pixhaus is useful to you, consider sponsoring on GitHub Sponsors
        or Open Collective.
      </p>
      <a
        href="https://github.com/sponsors/pixhaus-app"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-5 text-sm font-medium px-5 py-2.5 rounded-lg transition-colors"
        style="background: rgba(124,108,239,0.12); color: var(--brand-indigo-300); border: 1px solid rgba(124,108,239,0.2);"
      >
        Sponsor on GitHub
      </a>
    </div>
  </div>
</BaseLayout>
